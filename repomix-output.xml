        <tr><td>createChannel</td><td>conn.createChannel()</td><td>Standard channel</td></tr>
        <tr><td>createConfirmChannel</td><td>conn.createConfirmChannel()</td><td>Awaitable publish</td></tr>
        <tr><td>assertExchange</td><td>ch.assertExchange(name, type, opts?)</td><td>Idempotent</td></tr>
        <tr><td>assertQueue</td><td>ch.assertQueue(name, opts?)</td><td>Returns AssertQueue</td></tr>
        <tr><td>bindQueue</td><td>ch.bindQueue(q, ex, key, args?)</td><td>—</td></tr>
