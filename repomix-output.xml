  <!-- ════════════════════════════════════════
       SECTION 3 — CONNECTION & CHANNEL
  ════════════════════════════════════════ -->
  <section id="s3" class="section">
    <div class="section-header">
      <span class="section-num">03</span>
      <h2>Connection &amp; Channel</h2>
      <p>The two-layer model: TCP connection → logical channels</p>
    </div>

    <div class="tip"><strong>Tip:</strong> Create <strong>one connection per process</strong>, and <strong>one channel per async task / worker</strong>. Channels are cheap; connections are not.</div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-ts"></span>
        <span class="filename">connection.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="k">import</span> <span class="v">amqp</span>, { <span class="t">Connection</span>, <span class="t">Channel</span>, <span class="t">ConfirmChannel</span> } <span class="k">from</span> <span class="s">'amqplib'</span>;

<span class="c">// ── Basic connection ──────────────────────────────────</span>
<span class="k">const</span> <span class="v">conn</span>: <span class="t">Connection</span> = <span class="k">await</span> <span class="v">amqp</span>.<span class="f">connect</span>(<span class="s">'amqp://localhost'</span>);

<span class="c">// ── Standard channel (fire-and-forget publishes) ──────</span>
<span class="k">const</span> <span class="v">ch</span>: <span class="t">Channel</span> = <span class="k">await</span> <span class="v">conn</span>.<span class="f">createChannel</span>();

<span class="c">// ── Confirm channel (broker ACKs every publish) ───────</span>
<span class="k">const</span> <span class="v">cc</span>: <span class="t">ConfirmChannel</span> = <span class="k">await</span> <span class="v">conn</span>.<span class="f">createConfirmChannel</span>();

<span class="c">// ── Graceful shutdown ─────────────────────────────────</span>
<span class="k">async function</span> <span class="f">shutdown</span>() {
  <span class="k">await</span> <span class="v">ch</span>.<span class="f">close</span>();
  <span class="k">await</span> <span class="v">conn</span>.<span class="f">close</span>();
}

process.<span class="f">on</span>(<span class="s">'SIGINT'</span>, <span class="f">shutdown</span>);
process.<span class="f">on</span>(<span class="s">'SIGTERM'</span>, <span class="f">shutdown</span>);

<span class="c">// ── Connection events ─────────────────────────────────</span>
<span class="v">conn</span>.<span class="f">on</span>(<span class="s">'error'</span>, (<span class="v">err</span>) =&gt; console.<span class="f">error</span>(<span class="s">'Connection error'</span>, <span class="v">err</span>));
<span class="v">conn</span>.<span class="f">on</span>(<span class="s">'close'</span>, () =&gt; console.<span class="f">log</span>(<span class="s">'Connection closed'</span>));</pre>
    </div>

    <div class="card">
      <div class="card-header"><span class="dot dot-yellow"></span><h3>Connection vs Channel — quick reference</h3></div>
      <table>
        <tr><th>Property</th><th>Connection</th><th>Channel</th></tr>
        <tr><td>Protocol layer</td><td>TCP socket</td><td>Logical multiplexed</td></tr>
        <tr><td>Cost</td><td>High (OS socket, TLS)</td><td>Very low</td></tr>
        <tr><td>Recommended count</td><td>1 per process</td><td>1 per async task</td></tr>
        <tr><td>Reuse</td><td>Yes</td><td>Yes, but isolate tasks</td></tr>
        <tr><td>Error scope</td><td>Kills all channels</td><td>Closes only itself</td></tr>
      </table>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 4 — EXCHANGES
  ════════════════════════════════════════ -->
  <section id="s4" class="section">
    <div class="section-header">
      <span class="section-num">04</span>
      <h2>Exchanges</h2>
      <p>Declaring exchanges and understanding their options</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-rabbit"></span>
        <span class="filename">exchanges.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// assertExchange(name, type, options) — idempotent declare</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">assertExchange</span>(
  <span class="s">'my.exchange'</span>,          <span class="c">// name</span>
  <span class="s">'direct'</span>,               <span class="c">// type: direct | fanout | topic | headers | x-delayed-message</span>
  {
    <span class="v">durable</span>:    <span class="n">true</span>,      <span class="c">// survive broker restart</span>
    <span class="v">autoDelete</span>: <span class="n">false</span>,     <span class="c">// delete when last binding removed</span>
    <span class="v">internal</span>:   <span class="n">false</span>,     <span class="c">// cannot be published to directly by clients</span>
    <span class="v">arguments</span>:  {},        <span class="c">// extra args (e.g. x-delayed-type)</span>
  }
);

<span class="c">// Check if exchange exists without creating it</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">checkExchange</span>(<span class="s">'my.exchange'</span>); <span class="c">// throws if missing</span>

<span class="c">// Delete an exchange</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">deleteExchange</span>(<span class="s">'my.exchange'</span>, { <span class="v">ifUnused</span>: <span class="n">false</span> });

<span class="c">// Default exchange — every queue auto-bound by its name</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">publish</span>(<span class="s">''</span>, <span class="s">'queue-name'</span>, <span class="t">Buffer</span>.<span class="f">from</span>(<span class="s">'hello'</span>));</pre>
    </div>

    <div class="card">
      <div class="card-header"><span class="dot dot-rabbit"></span><h3>Exchange option reference</h3></div>
      <table>
        <tr><th>Option</th><th>Type</th><th>Default</th><th>Effect</th></tr>
        <tr><td>durable</td><td>boolean</td><td>false</td><td>Survives broker restarts</td></tr>
        <tr><td>autoDelete</td><td>boolean</td><td>false</td><td>Removed when all consumers disconnect</td></tr>
        <tr><td>internal</td><td>boolean</td><td>false</td><td>Only routable from other exchanges (E2E)</td></tr>
        <tr><td>alternateExchange</td><td>string</td><td>—</td><td>Receives unroutable messages</td></tr>
      </table>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 5 — QUEUES
  ════════════════════════════════════════ -->
  <section id="s5" class="section">
    <div class="section-header">
      <span class="section-num">05</span>
      <h2>Queues</h2>
      <p>Declaring, checking, purging, and deleting queues</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-ts"></span>
        <span class="filename">queues.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="k">import</span> { <span class="t">Replies</span> } <span class="k">from</span> <span class="s">'amqplib'</span>;

<span class="c">// ── Assert (create if not exists) ─────────────────────</span>
<span class="k">const</span> <span class="v">q</span>: <span class="t">Replies.AssertQueue</span> = <span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(
  <span class="s">'tasks'</span>,                <span class="c">// name; '' = server-generated unique name</span>
  {
    <span class="v">durable</span>:    <span class="n">true</span>,      <span class="c">// survive restart</span>
    <span class="v">exclusive</span>:  <span class="n">false</span>,     <span class="c">// only this connection can use it</span>
    <span class="v">autoDelete</span>: <span class="n">false</span>,     <span class="c">// delete when last consumer disconnects</span>
    <span class="v">arguments</span>: {
      <span class="s">'x-message-ttl'</span>:       <span class="n">60000</span>,   <span class="c">// ms — messages expire</span>
      <span class="s">'x-dead-letter-exchange'</span>: <span class="s">'dlx'</span>, <span class="c">// DLX routing</span>
      <span class="s">'x-max-length'</span>:        <span class="n">10000</span>,   <span class="c">// max messages</span>
      <span class="s">'x-max-priority'</span>:      <span class="n">10</span>,      <span class="c">// enable priority (0–10)</span>
      <span class="s">'x-queue-type'</span>:        <span class="s">'classic'</span>, <span class="c">// classic | quorum | stream</span>
    }
  }
);
console.<span class="f">log</span>(<span class="v">q</span>.<span class="v">queue</span>);          <span class="c">// actual queue name</span>
console.<span class="f">log</span>(<span class="v">q</span>.<span class="v">messageCount</span>);   <span class="c">// messages in queue</span>
console.<span class="f">log</span>(<span class="v">q</span>.<span class="v">consumerCount</span>);  <span class="c">// active consumers</span>

<span class="c">// ── Server-generated (exclusive) queue ───────────────</span>
<span class="k">const</span> <span class="v">tmp</span> = <span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">''</span>, { <span class="v">exclusive</span>: <span class="n">true</span> });

<span class="c">// ── Check, purge, delete ──────────────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">checkQueue</span>(<span class="s">'tasks'</span>);
<span class="k">await</span> <span class="v">ch</span>.<span class="f">purgeQueue</span>(<span class="s">'tasks'</span>);
<span class="k">await</span> <span class="v">ch</span>.<span class="f">deleteQueue</span>(<span class="s">'tasks'</span>, { <span class="v">ifUnused</span>: <span class="n">false</span>, <span class="v">ifEmpty</span>: <span class="n">false</span> });</pre>
    </div>

    <div class="grid-2" style="margin-top:16px">
      <div class="card">
        <div class="card-header"><span class="dot dot-purple"></span><h3>Queue types</h3></div>
        <table>
          <tr><th>Type</th><th>Use case</th></tr>
          <tr><td>classic</td><td>General purpose, single-node or mirrored</td></tr>
          <tr><td>quorum</td><td>HA, at-least-once, replicated (Raft)</td></tr>
          <tr><td>stream</td><td>Replay / high-throughput log-style</td></tr>
        </table>
      </div>
      <div class="card">
        <div class="card-header"><span class="dot dot-yellow"></span><h3>Quorum queue declaration</h3></div>
<pre><span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'jobs'</span>, {
  <span class="v">durable</span>: <span class="n">true</span>,
  <span class="v">arguments</span>: {
    <span class="s">'x-queue-type'</span>: <span class="s">'quorum'</span>,
    <span class="s">'x-quorum-initial-group-size'</span>: <span class="n">3</span>
  }
});</pre>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 6 — BINDINGS
  ════════════════════════════════════════ -->
  <section id="s6" class="section">
    <div class="section-header">
      <span class="section-num">06</span>
      <h2>Bindings &amp; Routing</h2>
      <p>Connecting exchanges to queues and exchange-to-exchange</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-rabbit"></span>
        <span class="filename">bindings.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// ── Queue binding ─────────────────────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(
  <span class="s">'tasks'</span>,          <span class="c">// queue name</span>
  <span class="s">'my.exchange'</span>,    <span class="c">// exchange name</span>
  <span class="s">'task.created'</span>    <span class="c">// routing key ('' for fanout)</span>
);

<span class="c">// ── Unbind queue ──────────────────────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">unbindQueue</span>(<span class="s">'tasks'</span>, <span class="s">'my.exchange'</span>, <span class="s">'task.created'</span>);

<span class="c">// ── Exchange-to-Exchange binding ──────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindExchange</span>(
  <span class="s">'downstream-ex'</span>,  <span class="c">// destination exchange</span>
  <span class="s">'upstream-ex'</span>,    <span class="c">// source exchange</span>
  <span class="s">'routing-key'</span>
);

<span class="c">// ── Topic pattern examples ────────────────────────────</span>
<span class="c">// '*' matches exactly ONE word segment</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'q'</span>, <span class="s">'topic-ex'</span>, <span class="s">'order.*.shipped'</span>);
<span class="c">// '#' matches ZERO or more word segments</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'q'</span>, <span class="s">'topic-ex'</span>, <span class="s">'order.#'</span>);</pre>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 7 — PUBLISHING
  ════════════════════════════════════════ -->
  <section id="s7" class="section">
    <div class="section-header">
      <span class="section-num">07</span>
      <h2>Publishing Messages</h2>
      <p>Sending messages with all publish options explained</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-ts"></span>
        <span class="filename">publisher.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// ── Basic publish ─────────────────────────────────────</span>
<span class="k">const</span> <span class="v">payload</span> = <span class="t">Buffer</span>.<span class="f">from</span>(<span class="t">JSON</span>.<span class="f">stringify</span>({ <span class="v">id</span>: <span class="n">1</span>, <span class="v">name</span>: <span class="s">'Widget'</span> }));

<span class="c">// publish(exchange, routingKey, content, options)</span>
<span class="k">const</span> <span class="v">ok</span>: <span class="n">boolean</span> = <span class="v">ch</span>.<span class="f">publish</span>(
  <span class="s">'my.exchange'</span>,    <span class="c">// '' = default exchange</span>
  <span class="s">'task.created'</span>,
  <span class="v">payload</span>,
  {
    <span class="v">persistent</span>:      <span class="n">true</span>,          <span class="c">// survive restart (deliveryMode:2)</span>
    <span class="v">contentType</span>:     <span class="s">'application/json'</span>,
    <span class="v">contentEncoding</span>: <span class="s">'utf-8'</span>,
    <span class="v">mandatory</span>:       <span class="n">false</span>,         <span class="c">// return if unroutable</span>
    <span class="v">expiration</span>:      <span class="s">'30000'</span>,        <span class="c">// per-message TTL in ms (string!)</span>
    <span class="v">priority</span>:        <span class="n">5</span>,              <span class="c">// 0–255; queue must support it</span>
    <span class="v">messageId</span>:       <span class="s">'msg-uuid-123'</span>,
    <span class="v">timestamp</span>:       <span class="t">Date</span>.<span class="f">now</span>() / <span class="n">1000</span>,
    <span class="v">appId</span>:           <span class="s">'my-service'</span>,
    <span class="v">correlationId</span>:   <span class="s">'corr-abc'</span>,
    <span class="v">replyTo</span>:         <span class="s">'reply-queue'</span>,
    <span class="v">headers</span>: { <span class="s">'x-retry-count'</span>: <span class="n">0</span> }
  }
);
<span class="c">// ok === false means the internal write buffer is full → handle backpressure</span>
<span class="k">if</span> (!<span class="v">ok</span>) <span class="k">await</span> <span class="k">new</span> <span class="t">Promise</span>(<span class="v">res</span> =&gt; <span class="v">ch</span>.<span class="f">once</span>(<span class="s">'drain'</span>, <span class="v">res</span>));

<span class="c">// ── sendToQueue shorthand (uses default exchange) ─────</span>
<span class="v">ch</span>.<span class="f">sendToQueue</span>(<span class="s">'tasks'</span>, <span class="v">payload</span>, { <span class="v">persistent</span>: <span class="n">true</span> });

<span class="c">// ── Confirm channel — await broker ACK ────────────────</span>
<span class="k">await new</span> <span class="t">Promise</span>&lt;<span class="k">void</span>&gt;((<span class="v">resolve</span>, <span class="v">reject</span>) =&gt; {
  <span class="v">cc</span>.<span class="f">publish</span>(<span class="s">''</span>, <span class="s">'tasks'</span>, <span class="v">payload</span>, {}, (<span class="v">err</span>) =&gt;
    <span class="v">err</span> ? <span class="f">reject</span>(<span class="v">err</span>) : <span class="f">resolve</span>()
  );
});</pre>
    </div>

    <div class="tip" style="margin-top:12px"><strong>Tip:</strong> <code>publish()</code> returns <code>false</code> when the socket buffer is full. Await the <code>'drain'</code> event before publishing again to avoid memory pressure.</div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 8 — CONSUMING
  ════════════════════════════════════════ -->
  <section id="s8" class="section">
    <div class="section-header">
      <span class="section-num">08</span>
      <h2>Consuming Messages</h2>
      <p>Subscribing to queues and handling message objects</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-green"></span>
        <span class="filename">consumer.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="k">import</span> { <span class="t">ConsumeMessage</span>, <span class="t">Replies</span> } <span class="k">from</span> <span class="s">'amqplib'</span>;

<span class="c">// ── consume(queue, callback, options) ─────────────────</span>
<span class="k">const</span> { <span class="v">consumerTag</span> }: <span class="t">Replies.Consume</span> = <span class="k">await</span> <span class="v">ch</span>.<span class="f">consume</span>(
  <span class="s">'tasks'</span>,
  (<span class="v">msg</span>: <span class="t">ConsumeMessage</span> | <span class="k">null</span>) =&gt; {
    <span class="k">if</span> (!<span class="v">msg</span>) <span class="k">return</span>; <span class="c">// null = consumer cancelled by broker</span>

    <span class="c">// ── Message fields ────────────────────────────────</span>
    <span class="v">msg</span>.<span class="v">content</span>;              <span class="c">// Buffer</span>
    <span class="v">msg</span>.<span class="v">fields</span>.<span class="v">exchange</span>;      <span class="c">// exchange it came from</span>
    <span class="v">msg</span>.<span class="v">fields</span>.<span class="v">routingKey</span>;   <span class="c">// routing key used</span>
    <span class="v">msg</span>.<span class="v">fields</span>.<span class="v">deliveryTag</span>;  <span class="c">// unique tag for ack/nack</span>
    <span class="v">msg</span>.<span class="v">fields</span>.<span class="v">redelivered</span>;  <span class="c">// boolean — was this redelivered?</span>
    <span class="v">msg</span>.<span class="v">properties</span>.<span class="v">contentType</span>;
    <span class="v">msg</span>.<span class="v">properties</span>.<span class="v">correlationId</span>;
    <span class="v">msg</span>.<span class="v">properties</span>.<span class="v">replyTo</span>;
    <span class="v">msg</span>.<span class="v">properties</span>.<span class="v">headers</span>;

    <span class="c">// ── Parse JSON payload ────────────────────────────</span>
    <span class="k">const</span> <span class="v">data</span> = <span class="t">JSON</span>.<span class="f">parse</span>(<span class="v">msg</span>.<span class="v">content</span>.<span class="f">toString</span>());

    <span class="c">// ── Process and acknowledge ───────────────────────</span>
    <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);
  },
  {
    <span class="v">noAck</span>:       <span class="n">false</span>,   <span class="c">// true = auto-ack (no ack needed)</span>
    <span class="v">exclusive</span>:   <span class="n">false</span>,   <span class="c">// only this consumer on the queue</span>
    <span class="v">consumerTag</span>: <span class="s">'worker-1'</span>, <span class="c">// custom tag; auto-generated if omitted</span>
    <span class="v">priority</span>:    <span class="n">0</span>,       <span class="c">// consumer priority</span>
    <span class="v">arguments</span>:   {},
  }
);

<span class="c">// ── Cancel a consumer (by tag) ────────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">cancel</span>(<span class="v">consumerTag</span>);

<span class="c">// ── Pull a single message (polling) ──────────────────</span>
<span class="k">const</span> <span class="v">single</span> = <span class="k">await</span> <span class="v">ch</span>.<span class="f">get</span>(<span class="s">'tasks'</span>, { <span class="v">noAck</span>: <span class="n">false</span> });
<span class="k">if</span> (<span class="v">single</span>) {
  console.<span class="f">log</span>(<span class="v">single</span>.<span class="v">content</span>.<span class="f">toString</span>());
  <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">single</span>);
}</pre>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 9 — ACK / NACK
  ════════════════════════════════════════ -->
  <section id="s9" class="section">
    <div class="section-header">
      <span class="section-num">09</span>
      <h2>Acknowledgements</h2>
      <p>ack, nack, reject — and when to use each</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-green"></span>
        <span class="filename">acks.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// ── ack(msg, allUpTo?) ────────────────────────────────</span>
<span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);              <span class="c">// ack single message</span>
<span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>, <span class="n">true</span>);        <span class="c">// ack all unacked messages up to this one</span>

<span class="c">// ── nack(msg, allUpTo?, requeue?) ─────────────────────</span>
<span class="v">ch</span>.<span class="f">nack</span>(<span class="v">msg</span>, <span class="n">false</span>, <span class="n">true</span>);  <span class="c">// nack + requeue</span>
<span class="v">ch</span>.<span class="f">nack</span>(<span class="v">msg</span>, <span class="n">false</span>, <span class="n">false</span>); <span class="c">// nack + discard (→ DLX if configured)</span>
<span class="v">ch</span>.<span class="f">nack</span>(<span class="v">msg</span>, <span class="n">true</span>,  <span class="n">false</span>); <span class="c">// nack all up to this, discard all</span>

<span class="c">// ── reject(msg, requeue?) — single message only ───────</span>
<span class="v">ch</span>.<span class="f">reject</span>(<span class="v">msg</span>, <span class="n">true</span>);       <span class="c">// same as nack(msg, false, true)</span>
<span class="v">ch</span>.<span class="f">reject</span>(<span class="v">msg</span>, <span class="n">false</span>);      <span class="c">// discard (→ DLX)</span>

<span class="c">// ── Safe consumer pattern with try/catch ──────────────</span>
<span class="v">ch</span>.<span class="f">consume</span>(<span class="s">'tasks'</span>, <span class="k">async</span> (<span class="v">msg</span>) =&gt; {
  <span class="k">if</span> (!<span class="v">msg</span>) <span class="k">return</span>;
  <span class="k">try</span> {
    <span class="k">await</span> <span class="f">processJob</span>(<span class="v">msg</span>);
    <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);
  } <span class="k">catch</span> (<span class="v">err</span>) {
    <span class="k">const</span> <span class="v">requeue</span> = !<span class="v">msg</span>.<span class="v">fields</span>.<span class="v">redelivered</span>; <span class="c">// requeue only once</span>
    <span class="v">ch</span>.<span class="f">nack</span>(<span class="v">msg</span>, <span class="n">false</span>, <span class="v">requeue</span>);
  }
});</pre>
    </div>

    <div class="card" style="margin-top:16px">
      <div class="card-header"><span class="dot dot-yellow"></span><h3>Ack decision tree</h3></div>
      <table>
        <tr><th>Outcome</th><th>Call</th><th>Result</th></tr>
        <tr><td>Success</td><td>ack(msg)</td><td>Removed from queue</td></tr>
        <tr><td>Transient error, retry</td><td>nack(msg, false, true)</td><td>Re-enqueued at head</td></tr>
        <tr><td>Permanent failure</td><td>nack(msg, false, false)</td><td>Dead-lettered or dropped</td></tr>
        <tr><td>Poison message</td><td>reject(msg, false)</td><td>Sent to DLX</td></tr>
      </table>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 10 — EXCHANGE TYPES
  ════════════════════════════════════════ -->
  <section id="s10" class="section">
    <div class="section-header">
      <span class="section-num">10</span>
      <h2>Exchange Types In Depth</h2>
      <p>direct · fanout · topic · headers — full working examples</p>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-header"><span class="dot dot-rabbit"></span><h3>direct — exact routing key match</h3></div>
<pre><span class="k">await</span> <span class="v">ch</span>.<span class="f">assertExchange</span>(<span class="s">'logs'</span>, <span class="s">'direct'</span>, { <span class="v">durable</span>: <span class="n">true</span> });
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'error-queue'</span>, <span class="s">'logs'</span>, <span class="s">'error'</span>);
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'info-queue'</span>,  <span class="s">'logs'</span>, <span class="s">'info'</span>);

<span class="v">ch</span>.<span class="f">publish</span>(<span class="s">'logs'</span>, <span class="s">'error'</span>, <span class="t">Buffer</span>.<span class="f">from</span>(<span class="s">'DB down'</span>));
<span class="c">// → only 'error-queue' receives it</span></pre>
      </div>

      <div class="card">
        <div class="card-header"><span class="dot dot-ts"></span><h3>fanout — broadcast to all queues</h3></div>
<pre><span class="k">await</span> <span class="v">ch</span>.<span class="f">assertExchange</span>(<span class="s">'broadcast'</span>, <span class="s">'fanout'</span>, { <span class="v">durable</span>: <span class="n">true</span> });
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'service-a'</span>, <span class="s">'broadcast'</span>, <span class="s">''</span>);
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'service-b'</span>, <span class="s">'broadcast'</span>, <span class="s">''</span>);

<span class="c">// routing key ignored by fanout</span>
<span class="v">ch</span>.<span class="f">publish</span>(<span class="s">'broadcast'</span>, <span class="s">''</span>, <span class="t">Buffer</span>.<span class="f">from</span>(<span class="s">'deploy v2.0'</span>));
<span class="c">// → BOTH queues receive it</span></pre>
      </div>

      <div class="card">
        <div class="card-header"><span class="dot dot-purple"></span><h3>topic — wildcard routing</h3></div>
<pre><span class="k">await</span> <span class="v">ch</span>.<span class="f">assertExchange</span>(<span class="s">'events'</span>, <span class="s">'topic'</span>, { <span class="v">durable</span>: <span class="n">true</span> });

<span class="c">// '*' = one word;  '#' = zero or more words</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'all-orders'</span>,    <span class="s">'events'</span>, <span class="s">'order.#'</span>);
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'eu-orders'</span>,     <span class="s">'events'</span>, <span class="s">'order.*.eu'</span>);
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'shipped-orders'</span>,<span class="s">'events'</span>, <span class="s">'order.shipped.*'</span>);

<span class="v">ch</span>.<span class="f">publish</span>(<span class="s">'events'</span>, <span class="s">'order.placed.eu'</span>, <span class="t">Buffer</span>.<span class="f">from</span>(<span class="s">'…'</span>));
<span class="c">// → matches 'all-orders' and 'eu-orders'</span></pre>
      </div>

      <div class="card">
        <div class="card-header"><span class="dot dot-green"></span><h3>headers — attribute-based routing</h3></div>
<pre><span class="k">await</span> <span class="v">ch</span>.<span class="f">assertExchange</span>(<span class="s">'hx'</span>, <span class="s">'headers'</span>, { <span class="v">durable</span>: <span class="n">true</span> });
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'pdf-q'</span>, <span class="s">'hx'</span>, <span class="s">''</span>, {
  <span class="s">'x-match'</span>: <span class="s">'all'</span>, <span class="c">// 'all' (AND) | 'any' (OR)</span>
  <span class="s">'format'</span>:  <span class="s">'pdf'</span>,
  <span class="s">'region'</span>:  <span class="s">'eu'</span>,
});

<span class="v">ch</span>.<span class="f">publish</span>(<span class="s">'hx'</span>, <span class="s">''</span>, <span class="t">Buffer</span>.<span class="f">from</span>(<span class="s">'data'</span>), {
  <span class="v">headers</span>: { <span class="s">'format'</span>: <span class="s">'pdf'</span>, <span class="s">'region'</span>: <span class="s">'eu'</span> }
});
<span class="c">// → matches because ALL headers match</span></pre>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 11 — MESSAGE PROPERTIES
  ════════════════════════════════════════ -->
  <section id="s11" class="section">
    <div class="section-header">
      <span class="section-num">11</span>
      <h2>Message Properties &amp; Headers</h2>
      <p>Full reference for AMQP message metadata</p>
    </div>

    <div class="card">
      <div class="card-header"><span class="dot dot-ts"></span><h3>All publish options (Options.Publish)</h3></div>
      <table>
