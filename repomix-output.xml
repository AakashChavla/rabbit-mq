  <!-- ════════════════════════════════════════
       SECTION 12 — DLX
  ════════════════════════════════════════ -->
  <section id="s12" class="section">
    <div class="section-header">
      <span class="section-num">12</span>
      <h2>Dead Letter Exchanges (DLX)</h2>
      <p>Capture rejected, expired, or overflow messages</p>
    </div>

    <div class="diagram" style="margin-bottom:20px">
<span class="box">Producer</span> <span class="arr">──▶</span> <span class="box">main-exchange</span> <span class="arr">──▶</span> <span class="box">tasks-queue</span>
                                    <span class="lbl">  x-dead-letter-exchange: "dlx"</span>
              <span class="c">nack/reject/TTL/overflow</span>
                        <span class="arr">│</span>
                        <span class="arr">▼</span>
                  <span class="box">dlx (exchange)</span> <span class="arr">──▶</span> <span class="box">dead-letters-queue</span> <span class="arr">──▶</span> <span class="box">Inspector / Retry Logic</span>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-red"></span>
        <span class="filename">dlx.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// ── 1. Declare the DLX ───────────────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">assertExchange</span>(<span class="s">'dlx'</span>, <span class="s">'direct'</span>, { <span class="v">durable</span>: <span class="n">true</span> });

<span class="c">// ── 2. Declare the dead-letter queue ─────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'dead-letters'</span>, { <span class="v">durable</span>: <span class="n">true</span> });
<span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'dead-letters'</span>, <span class="s">'dlx'</span>, <span class="s">'tasks'</span>);

<span class="c">// ── 3. Main queue pointing to DLX ────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'tasks'</span>, {
  <span class="v">durable</span>: <span class="n">true</span>,
  <span class="v">arguments</span>: {
    <span class="s">'x-dead-letter-exchange'</span>:    <span class="s">'dlx'</span>,
    <span class="s">'x-dead-letter-routing-key'</span>: <span class="s">'tasks'</span>, <span class="c">// optional</span>
  }
});

<span class="c">// ── 4. Messages that die end up in 'dead-letters' ────</span>
<span class="c">// Causes: nack(false), reject(false), TTL expiry, overflow</span>

<span class="c">// ── 5. Inspect dead-letter headers ───────────────────</span>
<span class="v">ch</span>.<span class="f">consume</span>(<span class="s">'dead-letters'</span>, (<span class="v">msg</span>) =&gt; {
  <span class="k">if</span> (!<span class="v">msg</span>) <span class="k">return</span>;
  <span class="k">const</span> <span class="v">deaths</span> = <span class="v">msg</span>.<span class="v">properties</span>.<span class="v">headers</span>[<span class="s">'x-death'</span>];
  <span class="c">// x-death[0].reason: 'rejected' | 'expired' | 'maxlen'</span>
  <span class="c">// x-death[0].count: how many times dead-lettered</span>
  console.<span class="f">log</span>(<span class="v">deaths</span>);
  <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);
});</pre>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 13 — TTL / PRIORITY / LIMITS
  ════════════════════════════════════════ -->
  <section id="s13" class="section">
    <div class="section-header">
      <span class="section-num">13</span>
      <h2>TTL, Priority &amp; Limits</h2>
      <p>Controlling message lifetime, ordering, and queue size</p>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-header"><span class="dot dot-yellow"></span><h3>TTL</h3></div>
<pre><span class="c">// Queue-level TTL (all messages)</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'cache'</span>, {
  <span class="v">arguments</span>: { <span class="s">'x-message-ttl'</span>: <span class="n">5000</span> } <span class="c">// 5s</span>
});

<span class="c">// Per-message TTL (string value!)</span>
<span class="v">ch</span>.<span class="f">publish</span>(<span class="s">''</span>, <span class="s">'cache'</span>, <span class="v">buf</span>, {
  <span class="v">expiration</span>: <span class="s">'3000'</span>  <span class="c">// 3s</span>
});

<span class="c">// Queue expires if unused</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'temp'</span>, {
  <span class="v">arguments</span>: { <span class="s">'x-expires'</span>: <span class="n">60000</span> } <span class="c">// delete after 60s idle</span>
});</pre>
      </div>

      <div class="card">
        <div class="card-header"><span class="dot dot-purple"></span><h3>Priority queues</h3></div>
<pre><span class="c">// Declare queue with max priority</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'jobs'</span>, {
  <span class="v">arguments</span>: { <span class="s">'x-max-priority'</span>: <span class="n">10</span> }
});

<span class="c">// Publish with priority</span>
<span class="v">ch</span>.<span class="f">sendToQueue</span>(<span class="s">'jobs'</span>, <span class="v">buf</span>, { <span class="v">priority</span>: <span class="n">9</span> }); <span class="c">// high</span>
<span class="v">ch</span>.<span class="f">sendToQueue</span>(<span class="s">'jobs'</span>, <span class="v">buf</span>, { <span class="v">priority</span>: <span class="n">1</span> }); <span class="c">// low</span>
<span class="c">// Higher number = higher priority</span>
<span class="c">// Broker delivers highest priority first</span></pre>
      </div>

      <div class="card">
        <div class="card-header"><span class="dot dot-red"></span><h3>Length limits</h3></div>
<pre><span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'bounded'</span>, {
  <span class="v">arguments</span>: {
    <span class="s">'x-max-length'</span>:          <span class="n">1000</span>, <span class="c">// max messages</span>
    <span class="s">'x-max-length-bytes'</span>:    <span class="n">10485760</span>, <span class="c">// 10 MB</span>
    <span class="s">'x-overflow'</span>:            <span class="s">'drop-head'</span>,
    <span class="c">// drop-head: drop oldest (default)</span>
    <span class="c">// reject-publish: publisher gets channel error</span>
    <span class="c">// reject-publish-dlx: send to DLX</span>
  }
});</pre>
      </div>

      <div class="card">
        <div class="card-header"><span class="dot dot-green"></span><h3>Lazy queues (disk-backed)</h3></div>
<pre><span class="c">// Keeps messages on disk, not RAM</span>
<span class="c">// Good for huge queues with slow consumers</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'lazy-q'</span>, {
  <span class="v">durable</span>: <span class="n">true</span>,
  <span class="v">arguments</span>: {
    <span class="s">'x-queue-mode'</span>: <span class="s">'lazy'</span>
  }
});
<span class="c">// In RabbitMQ 3.12+ quorum queues are lazy by default</span></pre>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 14 — PREFETCH / QoS
  ════════════════════════════════════════ -->
  <section id="s14" class="section">
    <div class="section-header">
      <span class="section-num">14</span>
      <h2>Prefetch &amp; QoS</h2>
      <p>Flow-control to prevent consumers being overwhelmed</p>
    </div>

    <div class="warn"><strong>Warning:</strong> Without <code>prefetch</code>, RabbitMQ will push <em>all</em> queued messages to a consumer's in-memory buffer at once. Always set prefetch for worker consumers.</div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-yellow"></span>
        <span class="filename">prefetch.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// ── prefetch(count, global?) ──────────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">prefetch</span>(<span class="n">1</span>);
<span class="c">// Process 1 message at a time — sequential, fair dispatch</span>

<span class="k">await</span> <span class="v">ch</span>.<span class="f">prefetch</span>(<span class="n">10</span>);
<span class="c">// Buffer up to 10 unacked messages per consumer</span>

<span class="k">await</span> <span class="v">ch</span>.<span class="f">prefetch</span>(<span class="n">50</span>, <span class="n">true</span>);
<span class="c">// Global: shared limit across ALL consumers on channel</span>

<span class="c">// ── Typical async worker with controlled concurrency ──</span>
<span class="k">const</span> <span class="v">CONCURRENCY</span> = <span class="n">5</span>;
<span class="k">await</span> <span class="v">ch</span>.<span class="f">prefetch</span>(<span class="v">CONCURRENCY</span>);

<span class="v">ch</span>.<span class="f">consume</span>(<span class="s">'tasks'</span>, <span class="k">async</span> (<span class="v">msg</span>) =&gt; {
  <span class="k">if</span> (!<span class="v">msg</span>) <span class="k">return</span>;
  <span class="k">try</span> {
    <span class="k">await</span> <span class="f">heavyWork</span>(<span class="v">msg</span>);
    <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);               <span class="c">// ← only now does RabbitMQ push next</span>
  } <span class="k">catch</span> {
    <span class="v">ch</span>.<span class="f">nack</span>(<span class="v">msg</span>, <span class="n">false</span>, <span class="n">true</span>);
  }
});</pre>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 15 — RPC PATTERN
  ════════════════════════════════════════ -->
  <section id="s15" class="section">
    <div class="section-header">
      <span class="section-num">15</span>
      <h2>RPC Pattern</h2>
      <p>Request / reply over RabbitMQ using correlationId</p>
    </div>

    <div class="diagram" style="margin-bottom:20px">
<span class="box">Client</span> <span class="arr">── request (replyTo: tmp-q, correlationId: uuid) ──▶</span> <span class="box">rpc_queue</span> <span class="arr">──▶</span> <span class="box">Server</span>
<span class="box">Client</span> <span class="arr">◀── reply (correlationId: same uuid) ────────────────</span> <span class="box">tmp-q</span>   <span class="arr">◀──</span> <span class="box">Server</span>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-header"><span class="dot dot-ts"></span><h3>RPC Client</h3></div>
<pre><span class="k">import</span> { <span class="v">randomUUID</span> } <span class="k">from</span> <span class="s">'crypto'</span>;

<span class="k">async function</span> <span class="f">rpcCall</span>(<span class="v">ch</span>: <span class="t">Channel</span>, <span class="v">payload</span>: <span class="k">string</span>) {
  <span class="k">const</span> { <span class="v">queue</span>: <span class="v">replyQ</span> } = <span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">''</span>, {
    <span class="v">exclusive</span>: <span class="n">true</span>
  });
  <span class="k">const</span> <span class="v">corrId</span> = <span class="f">randomUUID</span>();

  <span class="k">return new</span> <span class="t">Promise</span>&lt;<span class="k">string</span>&gt;((<span class="v">resolve</span>) =&gt; {
    <span class="v">ch</span>.<span class="f">consume</span>(<span class="v">replyQ</span>, (<span class="v">msg</span>) =&gt; {
      <span class="k">if</span> (<span class="v">msg</span>?.<span class="v">properties</span>.<span class="v">correlationId</span> === <span class="v">corrId</span>) {
        <span class="f">resolve</span>(<span class="v">msg</span>.<span class="v">content</span>.<span class="f">toString</span>());
        <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);
        <span class="v">ch</span>.<span class="f">deleteQueue</span>(<span class="v">replyQ</span>);
      }
    }, { <span class="v">noAck</span>: <span class="n">false</span> });

    <span class="v">ch</span>.<span class="f">sendToQueue</span>(<span class="s">'rpc_queue'</span>,
      <span class="t">Buffer</span>.<span class="f">from</span>(<span class="v">payload</span>),
      { <span class="v">correlationId</span>: <span class="v">corrId</span>, <span class="v">replyTo</span>: <span class="v">replyQ</span> }
    );
  });
}</pre>
      </div>

      <div class="card">
        <div class="card-header"><span class="dot dot-green"></span><h3>RPC Server</h3></div>
<pre><span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'rpc_queue'</span>, { <span class="v">durable</span>: <span class="n">false</span> });
<span class="k">await</span> <span class="v">ch</span>.<span class="f">prefetch</span>(<span class="n">1</span>);

<span class="v">ch</span>.<span class="f">consume</span>(<span class="s">'rpc_queue'</span>, (<span class="v">msg</span>) =&gt; {
  <span class="k">if</span> (!<span class="v">msg</span>) <span class="k">return</span>;

  <span class="k">const</span> <span class="v">input</span>  = <span class="v">msg</span>.<span class="v">content</span>.<span class="f">toString</span>();
  <span class="k">const</span> <span class="v">result</span> = <span class="f">compute</span>(<span class="v">input</span>);

  <span class="v">ch</span>.<span class="f">sendToQueue</span>(
    <span class="v">msg</span>.<span class="v">properties</span>.<span class="v">replyTo</span>,
    <span class="t">Buffer</span>.<span class="f">from</span>(<span class="k">String</span>(<span class="v">result</span>)),
    { <span class="v">correlationId</span>: <span class="v">msg</span>.<span class="v">properties</span>.<span class="v">correlationId</span> }
  );
  <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);
});</pre>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 16 — PUB/SUB
  ════════════════════════════════════════ -->
  <section id="s16" class="section">
    <div class="section-header">
      <span class="section-num">16</span>
      <h2>Pub/Sub Pattern</h2>
      <p>Broadcasting events to multiple independent subscribers</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-ts"></span>
        <span class="filename">pubsub.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// ── Publisher ─────────────────────────────────────────</span>
<span class="k">async function</span> <span class="f">setupPublisher</span>(<span class="v">ch</span>: <span class="t">Channel</span>) {
  <span class="k">await</span> <span class="v">ch</span>.<span class="f">assertExchange</span>(<span class="s">'notifications'</span>, <span class="s">'fanout'</span>, { <span class="v">durable</span>: <span class="n">true</span> });

  <span class="k">const</span> <span class="f">publish</span> = (<span class="v">event</span>: <span class="t">object</span>) =&gt;
    <span class="v">ch</span>.<span class="f">publish</span>(
      <span class="s">'notifications'</span>, <span class="s">''</span>,
      <span class="t">Buffer</span>.<span class="f">from</span>(<span class="t">JSON</span>.<span class="f">stringify</span>(<span class="v">event</span>)),
      { <span class="v">persistent</span>: <span class="n">true</span>, <span class="v">contentType</span>: <span class="s">'application/json'</span> }
    );

  <span class="k">return</span> { <span class="v">publish</span> };
}

<span class="c">// ── Subscriber (each service gets its own queue) ──────</span>
<span class="k">async function</span> <span class="f">setupSubscriber</span>(<span class="v">ch</span>: <span class="t">Channel</span>, <span class="v">serviceName</span>: <span class="k">string</span>) {
  <span class="k">await</span> <span class="v">ch</span>.<span class="f">assertExchange</span>(<span class="s">'notifications'</span>, <span class="s">'fanout'</span>, { <span class="v">durable</span>: <span class="n">true</span> });

  <span class="c">// Named durable queue = persists between restarts</span>
  <span class="k">const</span> { <span class="v">queue</span> } = <span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">`sub.</span><span class="k">${</span><span class="v">serviceName</span><span class="k">}</span><span class="s">`</span>, { <span class="v">durable</span>: <span class="n">true</span> });
  <span class="k">await</span> <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="v">queue</span>, <span class="s">'notifications'</span>, <span class="s">''</span>);

  <span class="v">ch</span>.<span class="f">consume</span>(<span class="v">queue</span>, (<span class="v">msg</span>) =&gt; {
    <span class="k">if</span> (!<span class="v">msg</span>) <span class="k">return</span>;
    <span class="k">const</span> <span class="v">event</span> = <span class="t">JSON</span>.<span class="f">parse</span>(<span class="v">msg</span>.<span class="v">content</span>.<span class="f">toString</span>());
    console.<span class="f">log</span>(<span class="s">`[</span><span class="k">${</span><span class="v">serviceName</span><span class="k">}</span><span class="s">] received:`</span>, <span class="v">event</span>);
    <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);
  });
}</pre>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 17 — WORK QUEUE
  ════════════════════════════════════════ -->
  <section id="s17" class="section">
    <div class="section-header">
      <span class="section-num">17</span>
      <h2>Work Queue Pattern</h2>
      <p>Distributing tasks across multiple competing workers</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-green"></span>
        <span class="filename">work-queue.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// ── Producer (dispatcher) ─────────────────────────────</span>
<span class="k">async function</span> <span class="f">dispatchJob</span>(<span class="v">ch</span>: <span class="t">Channel</span>, <span class="v">job</span>: <span class="t">object</span>) {
  <span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'work-queue'</span>, { <span class="v">durable</span>: <span class="n">true</span> });
  <span class="v">ch</span>.<span class="f">sendToQueue</span>(
    <span class="s">'work-queue'</span>,
    <span class="t">Buffer</span>.<span class="f">from</span>(<span class="t">JSON</span>.<span class="f">stringify</span>(<span class="v">job</span>)),
    { <span class="v">persistent</span>: <span class="n">true</span> }   <span class="c">// survive restart</span>
  );
}

<span class="c">// ── Worker (N can run in parallel) ────────────────────</span>
<span class="k">async function</span> <span class="f">startWorker</span>(<span class="v">ch</span>: <span class="t">Channel</span>) {
  <span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'work-queue'</span>, { <span class="v">durable</span>: <span class="n">true</span> });
  <span class="k">await</span> <span class="v">ch</span>.<span class="f">prefetch</span>(<span class="n">1</span>); <span class="c">// fair dispatch: one at a time</span>

  console.<span class="f">log</span>(<span class="s">'[Worker] Waiting for jobs…'</span>);

  <span class="v">ch</span>.<span class="f">consume</span>(<span class="s">'work-queue'</span>, <span class="k">async</span> (<span class="v">msg</span>) =&gt; {
    <span class="k">if</span> (!<span class="v">msg</span>) <span class="k">return</span>;
    <span class="k">const</span> <span class="v">job</span> = <span class="t">JSON</span>.<span class="f">parse</span>(<span class="v">msg</span>.<span class="v">content</span>.<span class="f">toString</span>());
    console.<span class="f">log</span>(<span class="s">'Processing'</span>, <span class="v">job</span>);

    <span class="k">try</span> {
      <span class="k">await</span> <span class="f">processJob</span>(<span class="v">job</span>);
      <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);
      console.<span class="f">log</span>(<span class="s">'Done'</span>, <span class="v">job</span>);
    } <span class="k">catch</span> (<span class="v">err</span>) {
      <span class="c">// Retry once, then dead-letter</span>
      <span class="v">ch</span>.<span class="f">nack</span>(<span class="v">msg</span>, <span class="n">false</span>, !<span class="v">msg</span>.<span class="v">fields</span>.<span class="v">redelivered</span>);
    }
  });
}</pre>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 18 — RESILIENCE
  ════════════════════════════════════════ -->
  <section id="s18" class="section">
    <div class="section-header">
      <span class="section-num">18</span>
      <h2>Connection Resilience</h2>
      <p>Auto-reconnect with amqp-connection-manager</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-ts"></span>
        <span class="filename">resilient-connection.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="k">import</span> <span class="f">amqp</span> <span class="k">from</span> <span class="s">'amqp-connection-manager'</span>;
<span class="k">import</span> { <span class="t">ChannelWrapper</span> } <span class="k">from</span> <span class="s">'amqp-connection-manager'</span>;
<span class="k">import</span> { <span class="t">ConsumeMessage</span> } <span class="k">from</span> <span class="s">'amqplib'</span>;

<span class="c">// ── Create managed connection ─────────────────────────</span>
<span class="k">const</span> <span class="v">mgr</span> = <span class="f">amqp</span>.<span class="f">connect</span>(
  [<span class="s">'amqp://rabbit1'</span>, <span class="s">'amqp://rabbit2'</span>], <span class="c">// failover list</span>
  {
    <span class="v">heartbeatIntervalInSeconds</span>: <span class="n">5</span>,
    <span class="v">reconnectTimeInSeconds</span>:    <span class="n">5</span>,
  }
);

<span class="v">mgr</span>.<span class="f">on</span>(<span class="s">'connect'</span>,    () =&gt; console.<span class="f">log</span>(<span class="s">'Connected'</span>));
<span class="v">mgr</span>.<span class="f">on</span>(<span class="s">'disconnect'</span>, ({ <span class="v">err</span> }) =&gt; console.<span class="f">error</span>(<span class="s">'Disconnected'</span>, <span class="v">err</span>));

<span class="c">// ── Managed channel — auto-recreated on reconnect ─────</span>
<span class="k">const</span> <span class="v">ch</span>: <span class="t">ChannelWrapper</span> = <span class="v">mgr</span>.<span class="f">createChannel</span>({
  <span class="v">json</span>: <span class="n">true</span>,              <span class="c">// auto JSON serialize/deserialize</span>
  <span class="k">async</span> <span class="f">setup</span>(<span class="v">ch</span>) {
    <span class="c">// Runs every time channel is (re)created</span>
    <span class="k">await</span> <span class="t">Promise</span>.<span class="f">all</span>([
      <span class="v">ch</span>.<span class="f">assertExchange</span>(<span class="s">'events'</span>, <span class="s">'topic'</span>, { <span class="v">durable</span>: <span class="n">true</span> }),
      <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'tasks'</span>, { <span class="v">durable</span>: <span class="n">true</span> }),
      <span class="v">ch</span>.<span class="f">bindQueue</span>(<span class="s">'tasks'</span>, <span class="s">'events'</span>, <span class="s">'task.*'</span>),
      <span class="v">ch</span>.<span class="f">prefetch</span>(<span class="n">10</span>),
    ]);
    <span class="k">await</span> <span class="v">ch</span>.<span class="f">consume</span>(<span class="s">'tasks'</span>, <span class="v">onMessage</span>);
  }
});

<span class="c">// ── Publish via managed channel (queued during disconnects) </span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">publish</span>(<span class="s">'events'</span>, <span class="s">'task.created'</span>, { <span class="v">id</span>: <span class="n">42</span> });
<span class="k">await</span> <span class="v">ch</span>.<span class="f">sendToQueue</span>(<span class="s">'tasks'</span>, { <span class="v">id</span>: <span class="n">42</span> });

<span class="k">function</span> <span class="f">onMessage</span>(<span class="v">msg</span>: <span class="t">ConsumeMessage</span> | <span class="k">null</span>) {
  <span class="k">if</span> (!<span class="v">msg</span>) <span class="k">return</span>;
  console.<span class="f">log</span>(<span class="v">msg</span>.<span class="v">content</span>.<span class="f">toString</span>());
  <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);
}</pre>
    </div>

    <div class="tip" style="margin-top:12px"><strong>Key benefit:</strong> <code>amqp-connection-manager</code> buffers <code>publish()</code> calls made while disconnected and flushes them on reconnect, giving you transparent resilience.</div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 19 — STREAMS
  ════════════════════════════════════════ -->
  <section id="s19" class="section">
    <div class="section-header">
      <span class="section-num">19</span>
      <h2>RabbitMQ Streams</h2>
      <p>Persistent, replayable log-style queues (RabbitMQ ≥ 3.9)</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-purple"></span>
        <span class="filename">streams.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// ── Declare a stream queue ────────────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">assertQueue</span>(<span class="s">'events-stream'</span>, {
  <span class="v">durable</span>: <span class="n">true</span>,
  <span class="v">arguments</span>: {
    <span class="s">'x-queue-type'</span>:       <span class="s">'stream'</span>,
    <span class="s">'x-max-length-bytes'</span>: <span class="n">1073741824</span>,  <span class="c">// 1 GB retention</span>
    <span class="s">'x-stream-max-segment-size-bytes'</span>: <span class="n">104857600</span>, <span class="c">// 100 MB segments</span>
    <span class="s">'x-max-age'</span>:          <span class="s">'7D'</span>,          <span class="c">// 7 days retention</span>
  }
});

<span class="c">// ── Publish to stream ─────────────────────────────────</span>
<span class="v">ch</span>.<span class="f">sendToQueue</span>(<span class="s">'events-stream'</span>,
  <span class="t">Buffer</span>.<span class="f">from</span>(<span class="t">JSON</span>.<span class="f">stringify</span>({ <span class="v">event</span>: <span class="s">'order.placed'</span> })),
  { <span class="v">persistent</span>: <span class="n">true</span> }
);

<span class="c">// ── Consume from offset ───────────────────────────────</span>
<span class="k">await</span> <span class="v">ch</span>.<span class="f">prefetch</span>(<span class="n">100</span>);  <span class="c">// required for streams!</span>
<span class="v">ch</span>.<span class="f">consume</span>(<span class="s">'events-stream'</span>, (<span class="v">msg</span>) =&gt; {
  <span class="k">if</span> (!<span class="v">msg</span>) <span class="k">return</span>;
  console.<span class="f">log</span>(<span class="v">msg</span>.<span class="v">content</span>.<span class="f">toString</span>());
  <span class="v">ch</span>.<span class="f">ack</span>(<span class="v">msg</span>);
}, {
  <span class="v">arguments</span>: {
    <span class="s">'x-stream-offset'</span>: <span class="s">'first'</span>,   <span class="c">// first | last | next | timestamp | offset-number</span>
    <span class="c">// 'x-stream-offset': new Date('2025-01-01'),  // from timestamp</span>
    <span class="c">// 'x-stream-offset': 1000,                    // from sequence offset</span>
  }
});</pre>
    </div>

    <div class="grid-2" style="margin-top:16px">
      <div class="card">
        <div class="card-header"><span class="dot dot-purple"></span><h3>Stream vs Classic Queue</h3></div>
        <table>
          <tr><th>Feature</th><th>Classic</th><th>Stream</th></tr>
          <tr><td>Message replay</td><td>No</td><td>Yes</td></tr>
          <tr><td>Multiple consumer reads</td><td>No (competing)</td><td>Yes (each offset)</td></tr>
          <tr><td>Retention</td><td>Until acked</td><td>Time/size based</td></tr>
          <tr><td>Max throughput</td><td>Medium</td><td>Very high</td></tr>
        </table>
      </div>
      <div class="card">
        <div class="card-header"><span class="dot dot-yellow"></span><h3>Stream offset types</h3></div>
        <div class="info">
          <p><strong>first</strong> — from the very beginning of the stream</p>
          <p><strong>last</strong> — from the last segment (catchup)</p>
          <p><strong>next</strong> — only new messages going forward</p>
          <p><strong>timestamp</strong> — from a specific Date object</p>
          <p><strong>number</strong> — from a specific sequence number</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       SECTION 20 — ERROR HANDLING & BEST PRACTICES
  ════════════════════════════════════════ -->
  <section id="s20" class="section">
    <div class="section-header">
      <span class="section-num">20</span>
      <h2>Error Handling &amp; Best Practices</h2>
      <p>Production-grade patterns and common pitfalls</p>
    </div>

    <div class="code-card">
      <div class="code-card-header">
        <span class="dot dot-red"></span>
        <span class="filename">best-practices.ts</span>
        <span class="lang-pill">TypeScript</span>
      </div>
<pre><span class="c">// ── 1. Handle channel errors (they close the channel) ─</span>
<span class="v">ch</span>.<span class="f">on</span>(<span class="s">'error'</span>, (<span class="v">err</span>) =&gt; console.<span class="f">error</span>(<span class="s">'Channel error'</span>, <span class="v">err</span>));
<span class="v">ch</span>.<span class="f">on</span>(<span class="s">'close'</span>, () =&gt; console.<span class="f">log</span>(<span class="s">'Channel closed — recreate!'</span>));

<span class="c">// ── 2. Handle mandatory returns (unroutable messages) ─</span>
<span class="v">ch</span>.<span class="f">on</span>(<span class="s">'return'</span>, (<span class="v">msg</span>) =&gt; {
  console.<span class="f">error</span>(<span class="s">'Returned (unroutable):'</span>, <span class="v">msg</span>.<span class="v">fields</span>.<span class="v">routingKey</span>);
});

<span class="c">// ── 3. Don't share channels across async tasks ────────</span>
<span class="c">// BAD: one channel for producers and consumers</span>
<span class="c">// GOOD: separate channels per concern</span>
<span class="k">const</span> <span class="v">publishCh</span> = <span class="k">await</span> <span class="v">conn</span>.<span class="f">createConfirmChannel</span>();
<span class="k">const</span> <span class="v">consumeCh</span> = <span class="k">await</span> <span class="v">conn</span>.<span class="f">createChannel</span>();

<span class="c">// ── 4. JSON type-safe publish helper ─────────────────</span>
<span class="k">function</span> <span class="f">publishJSON</span>&lt;<span class="t">T</span>&gt;(
  <span class="v">ch</span>: <span class="t">Channel</span>,
  <span class="v">exchange</span>: <span class="k">string</span>,
  <span class="v">routingKey</span>: <span class="k">string</span>,
  <span class="v">payload</span>: <span class="t">T</span>
): <span class="k">boolean</span> {
  <span class="k">return</span> <span class="v">ch</span>.<span class="f">publish</span>(
    <span class="v">exchange</span>, <span class="v">routingKey</span>,
    <span class="t">Buffer</span>.<span class="f">from</span>(<span class="t">JSON</span>.<span class="f">stringify</span>(<span class="v">payload</span>)),
    { <span class="v">persistent</span>: <span class="n">true</span>, <span class="v">contentType</span>: <span class="s">'application/json'</span> }
  );
}

<span class="c">// ── 5. Type-safe message handler ─────────────────────</span>
<span class="k">function</span> <span class="f">parseMessage</span>&lt;<span class="t">T</span>&gt;(<span class="v">msg</span>: <span class="t">ConsumeMessage</span>): <span class="t">T</span> {
  <span class="k">return</span> <span class="t">JSON</span>.<span class="f">parse</span>(<span class="v">msg</span>.<span class="v">content</span>.<span class="f">toString</span>()) <span class="k">as</span> <span class="t">T</span>;
}</pre>
    </div>

    <div class="grid-3" style="margin-top:16px">
      <div class="card">
        <div class="card-header"><span class="dot dot-green"></span><h3>Production checklist</h3></div>
        <div class="info">
          <p>✅ <strong>durable: true</strong> on all exchanges &amp; queues</p>
          <p>✅ <strong>persistent: true</strong> on all messages</p>
          <p>✅ Set <strong>prefetch</strong> on every consumer channel</p>
          <p>✅ Use <strong>confirm channels</strong> for critical publishes</p>
          <p>✅ Configure <strong>DLX</strong> for every work queue</p>
          <p>✅ Use <strong>connection manager</strong> for auto-reconnect</p>
          <p>✅ Separate <strong>publish/consume channels</strong></p>
          <p>✅ Handle <strong>drain</strong> event for backpressure</p>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><span class="dot dot-red"></span><h3>Common pitfalls</h3></div>
        <div class="info">
          <p>❌ No prefetch → consumer gets all messages at once</p>
          <p>❌ Shared channel → errors cancel all operations</p>
          <p>❌ noAck: true → messages lost on crash</p>
          <p>❌ Forgetting ack → messages stuck &amp; redelivered</p>
          <p>❌ Infinite requeue → poison message loops</p>
          <p>❌ No DLX → failed messages silently discarded</p>
          <p>❌ No heartbeat → stale connections not detected</p>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><span class="dot dot-yellow"></span><h3>Monitoring commands</h3></div>
<pre style="font-size:11px"><span class="c"># List queues</span>
rabbitmqctl list_queues \
  name messages consumers

<span class="c"># List exchanges</span>
rabbitmqctl list_exchanges

<span class="c"># List bindings</span>
rabbitmqctl list_bindings

<span class="c"># List connections</span>
rabbitmqctl list_connections

<span class="c"># Purge a queue</span>
rabbitmqctl purge_queue tasks</pre>
      </div>
    </div>

