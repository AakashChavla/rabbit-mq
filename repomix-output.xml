  <section id="s1" class="section">
    <div class="section-header">
      <span class="section-num">01</span>
      <h2>Core Concepts &amp; Architecture</h2>
      <p>The vocabulary you need before writing a single line of code</p>
    </div>

    <div class="diagram" style="margin-bottom:20px">
<span class="box">Producer</span>  <span class="arr">──── publish ────▶</span>  <span class="box">Exchange</span>  <span class="arr">──── route ────▶</span>  <span class="box">Queue</span>  <span class="arr">──── deliver ────▶</span>  <span class="box">Consumer</span>
<span class="lbl">  (Publisher)                  (fanout/direct/topic/headers)           (buffer)                (Subscriber)</span>
    </div>

    <div class="concept-grid">
      <div class="concept">
        <div class="concept-name">Producer</div>
        <div class="concept-desc">Application that creates and sends messages.</div>
      </div>
      <div class="concept">
        <div class="concept-name">Consumer</div>
        <div class="concept-desc">Application that reads and processes messages from a queue.</div>
      </div>
      <div class="concept">
        <div class="concept-name">Broker</div>
        <div class="concept-desc">RabbitMQ server that receives, routes, and delivers messages.</div>
      </div>
      <div class="concept">
        <div class="concept-name">Exchange</div>
        <div class="concept-desc">Receives messages and routes them to queues based on bindings.</div>
      </div>
      <div class="concept">
        <div class="concept-name">Queue</div>
        <div class="concept-desc">Buffer that stores messages until a consumer retrieves them.</div>
      </div>
      <div class="concept">
        <div class="concept-name">Binding</div>
        <div class="concept-desc">Rule linking an exchange to a queue, optionally with a routing key.</div>
      </div>
      <div class="concept">
        <div class="concept-name">Routing Key</div>
        <div class="concept-desc">Label on a message used by exchanges to decide routing.</div>
      </div>
      <div class="concept">
        <div class="concept-name">Channel</div>
        <div class="concept-desc">Lightweight virtual connection inside a TCP connection. Use one per thread/async task.</div>
      </div>
      <div class="concept">
        <div class="concept-name">vHost</div>
        <div class="concept-desc">Virtual host — logical namespace for isolation on one broker.</div>
      </div>
      <div class="concept">
        <div class="concept-name">AMQP 0-9-1</div>
        <div class="concept-desc">The wire protocol RabbitMQ implements. amqplib speaks it natively.</div>
      </div>
      <div class="concept">
        <div class="concept-name">Ack / Nack</div>
        <div class="concept-desc">Acknowledgement signals — confirm processing or reject.</div>
      </div>
      <div class="concept">
        <div class="concept-name">DLX</div>
        <div class="concept-desc">Dead-Letter Exchange — receives rejected or expired messages.</div>
      </div>
    </div>
  </section>

